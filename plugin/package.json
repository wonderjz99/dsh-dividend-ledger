{
  "name": "dsh-dividend-ledger",
  "version": "0.1.0",
  "description": "A 股分红账本 DSH 插件 —— 薄 TypeScript 适配层，业务逻辑全部委托给 dividend_ledger Python 核心",
  "license": "MIT",
  "author": "dsh-dividend-ledger contributors",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dividend",
    "a-share",
    "stock",
    "ledger",
    "分红",
    "A股"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-dividend-ledger.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/OWNER/dsh-dividend-ledger/issues"
  },
  "homepage": "https://github.com/OWNER/dsh-dividend-ledger#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build:test && node --test lib-test/test/*.test.js",
    "check": "npm run typecheck && npm run test",
    "vendor": "node ../scripts/extract-dsh-packages.mjs",
    "build:test": "tsc -p tsconfig.test.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "external": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}
